# ============================================================
# CareLess Bot — 环境变量模板
# 复制为 .env 并填入实际值；.env 不应提交到版本控制
# ============================================================

# --- QQ / OneBot 连接 ---
ONEBOT_ACCESS_TOKEN=请替换为高强度随机令牌
ONEBOT_REVERSE_WS=ws://127.0.0.1:8080/onebot/v11/ws
BOT_QQ_ID=

# --- 全局与模块开关 ---
# false 表示关闭。BOT_ENABLED=false 时机器人不消费任何消息。
BOT_ENABLED=true
ADMIN_COMMANDS_ENABLED=true
PERSONA_ENABLED=true
PERSONA_CONTEXT_ENABLED=true
PERSONA_HARD_TRIGGER_ENABLED=true
# 默认仅在 @ 或短会话内回复，关闭随机插话。
PERSONA_SOFT_TRIGGER_ENABLED=false
LLM_ENABLED=true
# 本地调试可关闭；生产环境应保持 true。
AUDIT_ENABLED=true

# --- 白名单 (逗号分隔的 QQ 号) ---
WHITELIST_QQ_IDS=

# --- 允许的群 (逗号分隔的 group_id；留空表示全部允许) ---
ALLOWED_GROUP_IDS=

# --- 数据库 (MVP 阶段可选；不设置则使用内存存储) ---
# SQLALCHEMY_DATABASE_URL=mysql+aiomysql://bot:password@127.0.0.1:3306/bot

# --- 群聊人格 ---
PERSONA_ACTIVE_PROBABILITY=0.02
PERSONA_GROUP_COOLDOWN_SECONDS=600
PERSONA_USER_COOLDOWN_SECONDS=1200
PERSONA_MAX_ACTIVE_REPLIES_PER_HOUR=3
# 管理员在任意群 @ 或私聊时立即回复。
ADMIN_BYPASS_GROUP_ALLOWLIST=true
ADMIN_BYPASS_COOLDOWNS=true
# 普通成员默认不能私聊机器人。
GUEST_PRIVATE_REPLY_ENABLED=false
# 普通成员 @ 后创建短会话，最多两次机器人回复。
GUEST_CONVERSATION_MAX_REPLIES=2
GUEST_CONVERSATION_TTL_SECONDS=300
# 以下两项均按群独立计时；短会话内的自然接话不受它们阻断。
GUEST_GROUP_REPLY_COOLDOWN_SECONDS=120
GUEST_GROUP_MENTION_COOLDOWN_SECONDS=300
# 机器人回复硬限制：一行、20 字以内、无标点。
PERSONA_MAX_REPLY_LENGTH=20
PERSONA_QUIET_START=00:30
PERSONA_QUIET_END=07:30

# --- 上下文 ---
# 线性 QQ 上下文。20K 是近似 token 预算，超出时从最旧消息开始淘汰。
CONTEXT_MAX_TOKENS=20000
CONTEXT_MAX_MESSAGES=1000
# 上下文记忆保留时间（秒），默认 6 小时；机器人重启后内存记忆清空。
CONTEXT_TTL_SECONDS=21600
# 仅缓存同群、同上下文、同提示词的回复，避免串群和陈旧复用。
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL_SECONDS=60

# --- 运维 ---
OPS_BACKEND=mock
# 运维总开关；可分别关闭只读查询或会改变服务器状态的操作。
OPS_ENABLED=true
OPS_READ_ENABLED=true
OPS_WRITE_ENABLED=true
# true 时“启动”和“备份”（R1）也要求 /确认。
OPS_R1_REQUIRES_APPROVAL=false
OPS_COMMAND_TIMEOUT_SECONDS=30
# /服 日志 最多回传的行数，范围 1-1000。
OPS_MAX_LOG_LINES=100
APPROVAL_TTL_SECONDS=120

# --- LLM (可选) ---
# LLM_API_BASE=https://api.openai.com/v1
# LLM_API_KEY=sk-xxxxxxxx
# LLM_MODEL=gpt-4o-mini

# --- Hermes Agent (P2 预留) ---
# HERMES_API_BASE=http://127.0.0.1:8642/v1
# HERMES_API_KEY=

# --- 日志 ---
LOG_LEVEL=INFO

# --- 时区 ---
TIMEZONE=Asia/Shanghai
