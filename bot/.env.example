# ============================================================
# CareLess Bot - 环境变量模板
# 复制为 .env 并填入实际值；.env 不应提交到版本控制
# 本模板不会连接数据库、执行迁移或部署任何服务
# ============================================================

# --- 最小必填：默认内存模式也必须填写 ---
# 至少 8 位的随机令牌，且必须与 OneBot 端配置一致。
ONEBOT_ACCESS_TOKEN=请替换为高强度随机令牌
# 机器人自身 QQ 号，用于识别 @ 机器人。
BOT_QQ_ID=
# 逗号分隔的管理员 QQ 号。管理命令开启时不能为空。
WHITELIST_QQ_IDS=

# --- QQ / OneBot 连接 ---
# 机器人反向 WebSocket 服务的监听地址。NapCat 应连接 ws://HOST:PORT/onebot/v11/ws。
HOST=127.0.0.1
PORT=8080

# --- 全局与模块开关 ---
# false 时不消费任何入站消息，适合维护窗口。
BOT_ENABLED=true
# false 时不处理任何 / 命令。
ADMIN_COMMANDS_ENABLED=true
# false 时不记录人格上下文，也不生成闲聊回复。
PERSONA_ENABLED=true
# false 时人格只参考触发消息，不保留线性短期上下文。
PERSONA_CONTEXT_ENABLED=true
# 控制 @ 机器人、管理员私聊等硬触发；私聊同样受此开关影响。
PERSONA_HARD_TRIGGER_ENABLED=true
# 控制低概率随机场景检查；默认开启，但只有配置可用 LLM 才会调用模型。
PERSONA_SOFT_TRIGGER_ENABLED=true
# 即使为 true，也必须同时设置 LLM_API_BASE 和 LLM_API_KEY 才会调用远程模型。
LLM_ENABLED=true
# false 时不写审计事件，仅建议本地无状态调试使用。
AUDIT_ENABLED=true

# --- 普通成员允许范围 ---
# 逗号分隔 group_id；留空表示所有群均允许普通成员通过 @ 使用人格。
# 管理员是否绕过这个限制由 ADMIN_BYPASS_GROUP_ALLOWLIST 决定。
ALLOWED_GROUP_IDS=

# --- 可选数据库持久化 ---
# memory：默认，不需要数据库，进程重启后上下文等内存状态会清空。
# sqlalchemy：使用 ORM Store；必须设置 SQLALCHEMY_DATABASE_URL 并安装 aiomysql。
# 默认只校验数据库 revision；首次初始化时将 DATABASE_SCHEMA_MODE 改为 migrate。
STORAGE_BACKEND=memory
# SQLALCHEMY_DATABASE_URL=mysql+aiomysql://careless:change_me@127.0.0.1:3306/careless_bot?charset=utf8mb4
# validate：启动时检测连接并校验 revision，不一致则拒绝启动（默认）。
# migrate：启动时自动执行 Alembic upgrade head，适合首次初始化或单实例部署。
DATABASE_SCHEMA_MODE=validate
# 多实例同时启动时，MySQL advisory lock 的最长等待时间（秒）。
DATABASE_MIGRATION_LOCK_TIMEOUT_SECONDS=60

# --- 人格触发与短会话 ---
# 概率只决定是否让 AI 检查场景，不保证实际发言；AI 可以返回 no_reply。
PERSONA_ACTIVE_PROBABILITY=0.01
PERSONA_GROUP_COOLDOWN_SECONDS=120
PERSONA_USER_COOLDOWN_SECONDS=300
# 群聊每次最多携带 60 条理解上下文；只有近期目标窗口可被模型选中回复。
GROUP_CONTEXT_MAX_MESSAGES=60
# 近期目标窗口：最多 15 条、最近 180 秒，跨越 90 秒聊天空档时截断。
AMBIENT_MAX_MESSAGES=15
AMBIENT_MAX_AGE_SECONDS=180
AMBIENT_SCENE_GAP_SECONDS=90
# AI 检查与实际随机发言分别冷却；实际发言冷却复用上方群冷却 120 秒。
AMBIENT_AI_CHECK_COOLDOWN_SECONDS=30
# 每群初始最多 2 次随机发言额度，之后每 20 分钟恢复 1 次。
AMBIENT_BUCKET_CAPACITY=2
AMBIENT_BUCKET_REFILL_SECONDS=1200
AMBIENT_MAX_NEW_MESSAGES_DURING_GENERATION=5
# 按群开放、对象不限的 AI 会话窗口。
PERSONA_SESSION_TTL_SECONDS=120
PERSONA_SESSION_QUESTION_TTL_SECONDS=180
PERSONA_SESSION_MAX_BOT_TURNS=4
PERSONA_SESSION_MAX_AI_CHECKS=8
# 是否启用异步拟人延迟。false 时立即发送，便于本地调试。
PERSONA_REPLY_DELAY_ENABLED=true
# 每个群或私聊独立等待；新消息会替换同一作用域尚未发送的旧回复。
PERSONA_REPLY_DELAY_MIN_SECONDS=15
PERSONA_REPLY_DELAY_MAX_SECONDS=30
# 模型一次逻辑回复最多拆成三条实际 QQ 消息；通常应只返回一条。
PERSONA_REPLY_MAX_MESSAGES=3
# 第二、第三条消息之间的自然停顿，不伪造 QQ 的“正在输入”状态。
PERSONA_FOLLOWUP_DELAY_MIN_SECONDS=1
PERSONA_FOLLOWUP_DELAY_MAX_SECONDS=4
# 管理员在任意群 @ 或私聊时立即回复；可分别关闭对群白名单和冷却的绕过。
ADMIN_BYPASS_GROUP_ALLOWLIST=true
ADMIN_BYPASS_COOLDOWNS=true
# 普通成员私聊默认不回复。群聊 @ 或引用机器人可直接开启群级会话窗口。
GUEST_PRIVATE_REPLY_ENABLED=false
# 静默时段按 TIMEZONE 解释，支持跨午夜。
PERSONA_QUIET_START=00:30
PERSONA_QUIET_END=07:30

# --- 上下文、记忆与缓存 ---
# 线性 QQ 上下文，格式为“QQ号: 消息”。20K 为近似 token 预算，超出从最旧消息淘汰。
CONTEXT_MAX_TOKENS=20000
CONTEXT_MAX_MESSAGES=1000
# 上下文保留秒数，默认 6 小时。memory 模式重启会丢失，sqlalchemy 模式可持久化。
CONTEXT_TTL_SECONDS=21600
# 私聊使用独立提示词与窗口，每次最多携带 60 条私聊消息。
PRIVATE_CONTEXT_MAX_MESSAGES=60
# 精确回复缓存只命中同群、同上下文、同人格配置，避免跨群与陈旧复用。
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL_SECONDS=60

# --- 运维命令 ---
# 仅 mock 可用；real 是未来预留值，当前启动会拒绝。
OPS_BACKEND=mock
# 运维总开关，以及只读、写操作的独立开关。
OPS_ENABLED=true
OPS_READ_ENABLED=true
OPS_WRITE_ENABLED=true
# true 时“启动”和“备份”等 R1 操作也需要 /确认；R2 始终要求确认。
OPS_R1_REQUIRES_APPROVAL=false
OPS_COMMAND_TIMEOUT_SECONDS=30
# /服 日志最多回传行数，范围 1-1000。
OPS_MAX_LOG_LINES=100
# 一次性确认码的有效时间（秒）。
APPROVAL_TTL_SECONDS=120

# --- OpenAI 兼容 LLM（可选） ---
# 必须与 LLM_ENABLED=true 一起设置才会启用远程模型；未设置时使用本地降级回复。
# LLM_API_BASE=https://api.openai.com/v1
# LLM_API_KEY=sk-xxxxxxxx
# LLM_MODEL=gpt-4o-mini
# 单次请求超时；只延长等待，不进行自动重试或增加调用次数。
LLM_TIMEOUT_SECONDS=30
# 单次模型最大输出 token；用于控制单次远程调用的成本与延迟，不是字符长度限制。
LLM_MAX_TOKENS=160
# DeepSeek 等支持时，false 会传 thinking.type=disabled，避免推理占用短回复预算。
LLM_THINKING_ENABLED=false

# --- Hermes Agent（P2 预留，当前未接入） ---
# HERMES_API_BASE=http://127.0.0.1:8642/v1
# HERMES_API_KEY=

# --- 运行日志与时区 ---
# 默认日志等级在 config/logging.yml 配置。此项可选，用于部署时临时覆盖 YAML 等级。
# LOG_LEVEL=DEBUG
TIMEZONE=Asia/Shanghai
