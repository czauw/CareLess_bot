# ============================================================
# CareLess Bot - 环境变量模板
# 复制为 .env 并填入实际值；.env 不应提交到版本控制
# 本模板不会连接数据库、执行迁移或部署任何服务
# ============================================================

# --- 最小必填：默认内存模式也必须填写 ---
# 至少 8 位的随机令牌，且必须与 OneBot 端配置一致。
ONEBOT_ACCESS_TOKEN=请替换为高强度随机令牌
# 机器人自身 QQ 号，用于识别 @ 机器人。
BOT_QQ_ID=
# 逗号分隔的管理员 QQ 号。管理命令开启时不能为空。
WHITELIST_QQ_IDS=

# --- QQ / OneBot 连接 ---
ONEBOT_REVERSE_WS=ws://127.0.0.1:8080/onebot/v11/ws

# --- 全局与模块开关 ---
# false 时不消费任何入站消息，适合维护窗口。
BOT_ENABLED=true
# false 时不处理任何 / 命令。
ADMIN_COMMANDS_ENABLED=true
# false 时不记录人格上下文，也不生成闲聊回复。
PERSONA_ENABLED=true
# false 时人格只参考触发消息，不保留线性短期上下文。
PERSONA_CONTEXT_ENABLED=true
# 控制 @ 机器人、管理员私聊等硬触发；私聊同样受此开关影响。
PERSONA_HARD_TRIGGER_ENABLED=true
# 控制随机插话，默认关闭；普通成员仍可通过 @ 开启短会话。
PERSONA_SOFT_TRIGGER_ENABLED=false
# 即使为 true，也必须同时设置 LLM_API_BASE 和 LLM_API_KEY 才会调用远程模型。
LLM_ENABLED=true
# false 时不写审计事件，仅建议本地无状态调试使用。
AUDIT_ENABLED=true

# --- 普通成员允许范围 ---
# 逗号分隔 group_id；留空表示所有群均允许普通成员通过 @ 使用人格。
# 管理员是否绕过这个限制由 ADMIN_BYPASS_GROUP_ALLOWLIST 决定。
ALLOWED_GROUP_IDS=

# --- 可选数据库持久化 ---
# memory：默认，不需要数据库，进程重启后上下文等内存状态会清空。
# sqlalchemy：使用 ORM Store；必须设置 SQLALCHEMY_DATABASE_URL、安装 aiomysql 并显式执行迁移。
# 当前仓库只有 Alembic 环境入口，尚无初始迁移 revision；不要只改此项就连接生产库。
STORAGE_BACKEND=memory
# SQLALCHEMY_DATABASE_URL=mysql+aiomysql://careless:change_me@127.0.0.1:3306/careless_bot?charset=utf8mb4

# --- 人格触发与短会话 ---
# 以下四项是随机插话的通用门控。普通成员 @ 短会话主要使用下方 GUEST_GROUP_* 冷却。
PERSONA_ACTIVE_PROBABILITY=0.02
PERSONA_GROUP_COOLDOWN_SECONDS=600
PERSONA_USER_COOLDOWN_SECONDS=1200
PERSONA_MAX_ACTIVE_REPLIES_PER_HOUR=3
# 管理员在任意群 @ 或私聊时立即回复；可分别关闭对群白名单和冷却的绕过。
ADMIN_BYPASS_GROUP_ALLOWLIST=true
ADMIN_BYPASS_COOLDOWNS=true
# 普通成员私聊默认不回复。群聊必须 @ 机器人才能新建会话。
GUEST_PRIVATE_REPLY_ENABLED=false
# 每个普通成员会话最多机器人回复 1 到 2 次，代码强制限制上限为 2。
GUEST_CONVERSATION_MAX_REPLIES=2
# 会话有效期（秒）。过期后需重新 @ 机器人。
GUEST_CONVERSATION_TTL_SECONDS=300
# 以下两项均按群独立计时。短会话内同一发起人的自然接话可续聊。
GUEST_GROUP_REPLY_COOLDOWN_SECONDS=120
GUEST_GROUP_MENTION_COOLDOWN_SECONDS=300
# 所有机器人人格回复都会规整为单行、无标点，长度不超过 20 字。
PERSONA_MAX_REPLY_LENGTH=20
# 静默时段按 TIMEZONE 解释，支持跨午夜。
PERSONA_QUIET_START=00:30
PERSONA_QUIET_END=07:30

# --- 上下文、记忆与缓存 ---
# 线性 QQ 上下文，格式为“QQ号: 消息”。20K 为近似 token 预算，超出从最旧消息淘汰。
CONTEXT_MAX_TOKENS=20000
CONTEXT_MAX_MESSAGES=1000
# 上下文保留秒数，默认 6 小时。memory 模式重启会丢失，sqlalchemy 模式可持久化。
CONTEXT_TTL_SECONDS=21600
# 精确回复缓存只命中同群、同上下文、同人格配置，避免跨群与陈旧复用。
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL_SECONDS=60

# --- 运维命令 ---
# 仅 mock 可用；real 是未来预留值，当前启动会拒绝。
OPS_BACKEND=mock
# 运维总开关，以及只读、写操作的独立开关。
OPS_ENABLED=true
OPS_READ_ENABLED=true
OPS_WRITE_ENABLED=true
# true 时“启动”和“备份”等 R1 操作也需要 /确认；R2 始终要求确认。
OPS_R1_REQUIRES_APPROVAL=false
OPS_COMMAND_TIMEOUT_SECONDS=30
# /服 日志最多回传行数，范围 1-1000。
OPS_MAX_LOG_LINES=100
# 一次性确认码的有效时间（秒）。
APPROVAL_TTL_SECONDS=120

# --- OpenAI 兼容 LLM（可选） ---
# 必须与 LLM_ENABLED=true 一起设置才会启用远程模型；未设置时使用本地降级回复。
# LLM_API_BASE=https://api.openai.com/v1
# LLM_API_KEY=sk-xxxxxxxx
# LLM_MODEL=gpt-4o-mini

# --- Hermes Agent（P2 预留，当前未接入） ---
# HERMES_API_BASE=http://127.0.0.1:8642/v1
# HERMES_API_KEY=

# --- 运行日志与时区 ---
# 默认日志等级在 config/logging.yml 配置。此项可选，用于部署时临时覆盖 YAML 等级。
# LOG_LEVEL=DEBUG
TIMEZONE=Asia/Shanghai
