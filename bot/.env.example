# ============================================================
# CareLess Bot — 环境变量模板
# 复制为 .env 并填入实际值；.env 不应提交到版本控制
# ============================================================

# --- QQ / OneBot 连接 ---
ONEBOT_ACCESS_TOKEN=请替换为高强度随机令牌
ONEBOT_REVERSE_WS=ws://127.0.0.1:8080/onebot/v11/ws
BOT_QQ_ID=

# --- 白名单 (逗号分隔的 QQ 号) ---
WHITELIST_QQ_IDS=

# --- 允许的群 (逗号分隔的 group_id；留空表示全部允许) ---
ALLOWED_GROUP_IDS=

# --- 数据库 (MVP 阶段可选；不设置则使用内存存储) ---
# SQLALCHEMY_DATABASE_URL=mysql+aiomysql://bot:password@127.0.0.1:3306/bot

# --- 群聊人格 ---
PERSONA_ACTIVE_PROBABILITY=0.02
PERSONA_GROUP_COOLDOWN_SECONDS=600
PERSONA_USER_COOLDOWN_SECONDS=1200
PERSONA_MAX_ACTIVE_REPLIES_PER_HOUR=3
PERSONA_MAX_REPLY_LENGTH=80
PERSONA_QUIET_START=00:30
PERSONA_QUIET_END=07:30

# --- 上下文 ---
CONTEXT_MAX_MESSAGES=30
CONTEXT_TTL_SECONDS=1200

# --- 运维 ---
OPS_BACKEND=mock
OPS_COMMAND_TIMEOUT_SECONDS=30
APPROVAL_TTL_SECONDS=120

# --- LLM (可选) ---
# LLM_API_BASE=https://api.openai.com/v1
# LLM_API_KEY=sk-xxxxxxxx
# LLM_MODEL=gpt-4o-mini

# --- Hermes Agent (P2 预留) ---
# HERMES_API_BASE=http://127.0.0.1:8642/v1
# HERMES_API_KEY=

# --- 日志 ---
LOG_LEVEL=INFO

# --- 时区 ---
TIMEZONE=Asia/Shanghai
